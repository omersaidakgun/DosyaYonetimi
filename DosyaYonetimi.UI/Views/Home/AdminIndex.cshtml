@model DosyaYonetimi.UI.Models.AdminSummaryViewModel

@{
    ViewData["Title"] = "Sistem Genel Bakış";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-satellite-dish text-primary mr-2"></i> Sistem Genel Bakış</h1>
</div>

<div class="row">

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-primary shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Toplam Kullanıcı</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@(Model?.TotalUsers ?? 0) Kişi</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-users fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-success shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Aktif Dosyalar</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@(Model?.TotalActiveFiles ?? 0) Adet</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-file-alt fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-info shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Aktif Klasörler</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@(Model?.TotalActiveFolders ?? 0) Adet</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-folder fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-danger shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Çöpteki Dosyalar</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@(Model?.TotalFilesInTrash ?? 0) Adet</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-dumpster fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<div class="row">
    <div class="col-lg-12 mb-4">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Yönetici Paneline Hoş Geldiniz</h6>
            </div>
            <div class="card-body">
                <p>Bu ekrandan sistemin genel durumunu takip edebilir, kullanıcıların kotalarını belirleyebilir ve sunucu üzerindeki yükü yönetebilirsiniz.</p>
                <a href="/Admin/Users" class="btn btn-primary mt-2">
                    <i class="fas fa-users-cog fa-sm text-white-50 mr-1"></i> Kullanıcı Yönetimine Git
                </a>
            </div>
        </div>
    </div>
</div>