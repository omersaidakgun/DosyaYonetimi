@model IEnumerable<DosyaYonetimi.UI.Models.FileShareViewModel>
@{
    ViewData["Title"] = "Benimle Paylaşılanlar";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-share-alt text-info mr-2"></i> Benimle Paylaşılanlar</h1>
</div>

<div class="card shadow mb-4 border-left-info border-bottom-info">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="bg-light">
                    <tr>
                        <th>Dosya Bilgisi</th>
                        <th>Paylaşım Bitiş</th>
                        <th class="text-center">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var share in Model)
                        {
                            <tr>
                                <td class="align-middle font-weight-bold">
                                    <i class="fas fa-file-alt text-info mr-2"></i>
                                    @(string.IsNullOrEmpty(share.FileItemName) ? "Dosya ID: " + share.FileItemId : share.FileItemName)
                                </td>
                                <td class="align-middle text-danger">
                                    <i class="far fa-clock mr-1"></i> @share.EndDate.ToShortDateString()
                                </td>
                                <td class="text-center">
                                    <a href="/Home/DownloadFile/@share.FileItemId" class="btn btn-sm btn-info shadow-sm">
                                        <i class="fas fa-download"></i> İndir
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center py-5 text-muted">
                                <i class="fas fa-handshake fa-3x mb-3 d-block text-gray-300"></i>
                                Henüz sizinle paylaşılan bir dosya bulunamadı.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>