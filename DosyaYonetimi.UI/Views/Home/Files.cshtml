@model DosyaYonetimi.UI.Models.DriveViewModel
@{
    ViewData["Title"] = "Dosyalarım";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    
    var sortedFiles = Model.Files?.OrderByDescending(f => f.IsFavorite).ThenByDescending(f => f.Created).ToList();
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Dosyalarım</h1>
    <div>
        <button class="btn btn-primary btn-sm shadow-sm" data-toggle="modal" data-target="#uploadModal">
            <i class="fas fa-upload fa-sm text-white-50"></i> Yeni Dosya Yükle
        </button>
        <button class="btn btn-success btn-sm shadow-sm" data-toggle="modal" data-target="#folderModal">
            <i class="fas fa-folder-plus fa-sm text-white-50"></i> Yeni Klasör
        </button>
    </div>
</div>

@if (ViewBag.CurrentFolderId != null)
{
    <div class="mb-4">
        <a href="/Home/Files?folderId=@ViewBag.ParentFolderId" class="btn btn-secondary btn-icon-split shadow-sm">
            <span class="icon text-white-50"><i class="fas fa-arrow-left"></i></span>
            <span class="text">Üst Klasöre Dön (@ViewBag.CurrentFolderName)</span>
        </a>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Hata!</strong> @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Başarılı!</strong> @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
    </div>
}

<div class="card shadow mb-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0" width="100%" cellspacing="0">
                <thead class="bg-light">
                    <tr>
                        <th width="5%" class="text-center">Tip</th>
                        <th width="45%">Ad</th>
                        <th width="20%">Boyut</th>
                        <th width="15%">Tarih</th>
                        <th width="15%" class="text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Folders != null)
                    {
                        foreach (var folder in Model.Folders)
                        {
                            <tr>
                                <td class="text-center align-middle">
                                    <i class="fas fa-folder text-warning fa-lg"></i>
                                </td>
                                <td class="align-middle font-weight-bold text-dark">
                                    <a href="/Home/Files?folderId=@folder.Id" class="text-dark text-decoration-none">
                                        @folder.Name
                                    </a>
                                </td>
                                <td class="align-middle text-muted">-</td>
                                <td class="align-middle text-muted">@folder.Created.ToShortDateString()</td>
                                <td class="text-center align-middle">

                                    <form asp-action="DeleteFolder" asp-controller="Home" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@folder.Id" />
                                        <input type="hidden" name="currentFolderId" value="@ViewBag.CurrentFolderId" />
                                        <button type="submit" class="btn btn-sm btn-light text-danger" title="Sil" onclick="return confirm('Bu klasörü silmek istediğinize emin misiniz?');">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>

                                </td>
                            </tr>
                        }
                    }

                    @if (sortedFiles != null && sortedFiles.Any())
                    {
                        foreach (var file in sortedFiles)
                        {
                            <tr class="@(file.IsFavorite ? "bg-light" : "")">
                                <td class="text-center align-middle">
                                    @if (file.IsFavorite)
                                    {
                                        <i class="fas fa-star text-warning fa-lg"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-file-alt text-primary fa-lg"></i>
                                    }
                                </td>
                                <td class="align-middle text-dark font-weight-bold">
                                    @file.Name <span class="badge badge-secondary ml-2">@file.Extension</span>
                                </td>
                                <td class="align-middle text-muted">@file.SizeInMB.ToString("0.00") MB</td>
                                <td class="align-middle text-muted">@file.Created.ToShortDateString()</td>
                                <td class="text-center align-middle">

                                    <form asp-action="ToggleFavorite" asp-controller="Home" method="post" class="d-inline">
                                        <input type="hidden" name="fileId" value="@file.Id" />
                                        <button type="submit" class="btn btn-sm btn-light @(file.IsFavorite ? "text-warning" : "text-secondary")" title="Favori">
                                            <i class="@(file.IsFavorite ? "fas fa-star" : "far fa-star")"></i>
                                        </button>
                                    </form>

                                    <button class="btn btn-sm btn-light text-success" title="Paylaş"
                                            data-toggle="modal" data-target="#shareModal" data-id="@file.Id">
                                        <i class="fas fa-share-alt"></i>
                                    </button>

                                    <a href="/Home/DownloadFile/@file.Id" class="btn btn-sm btn-light text-info" title="İndir">
                                        <i class="fas fa-download"></i>
                                    </a>

                                    <form asp-action="DeleteFile" asp-controller="Home" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@file.Id" />
                                        <input type="hidden" name="currentFolderId" value="@ViewBag.CurrentFolderId" />
                                        <button type="submit" class="btn btn-sm btn-light text-danger" title="Çöpe At" onclick="return confirm('Silmek istediğinize emin misiniz?');">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>

                                </td>
                            </tr>
                        }
                    }

                    @if ((Model.Folders == null || !Model.Folders.Any()) && (Model.Files == null || !Model.Files.Any()))
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                <i class="fas fa-folder-open fa-2x mb-2 d-block text-gray-300"></i>
                                Buralar çok ıssız... Henüz hiç dosya veya klasör yok.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="folderModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateFolder" asp-controller="Home" method="post">
                <div class="modal-header">
                    <h5 class="modal-title font-weight-bold text-success"><i class="fas fa-folder-plus"></i> Yeni Klasör</h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="parentFolderId" value="@ViewBag.CurrentFolderId" />
                    <input type="text" name="folderName" class="form-control form-control-user" placeholder="Klasör adını girin..." required />
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">Oluştur</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="uploadModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Upload" asp-controller="Home" method="post" enctype="multipart/form-data">
                <div class="modal-header">
                    <h5 class="modal-title font-weight-bold text-primary"><i class="fas fa-upload"></i> Dosya Yükle</h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="folderId" value="@ViewBag.CurrentFolderId" />
                    <input type="file" name="file" class="form-control-file" required />
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Yükle</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="shareModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="ShareFile" asp-controller="Home" method="post">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title font-weight-bold"><i class="fas fa-share-alt"></i> Dosyayı Paylaş</h5>
                    <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="fileId" id="shareFileId" />

                    <div class="form-group">
                        <label class="font-weight-bold">Paylaşılacak Kişi</label>
                        <select name="receiverId" id="userSelect" class="form-control" required>
                            <option value="">Kullanıcı seçiliyor...</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold">Paylaşım Süresi (Gün)</label>
                        <select name="days" class="form-control">
                            <option value="1">1 Gün</option>
                            <option value="3">3 Gün</option>
                            <option value="7" selected>1 Hafta</option>
                            <option value="30">1 Ay</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success btn-block">Paylaşımı Başlat</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        
        $('#shareModal').on('show.bs.modal', function (event) {
            var button = $(event.relatedTarget);
            var fileId = button.data('id');
            var modal = $(this);
            modal.find('#shareFileId').val(fileId);

           
            $.get('/Home/GetUserList', function (data) {
                var select = $('#userSelect');
                select.empty();
                select.append('<option value="">Bir kullanıcı seçin...</option>');

                $.each(data, function (index, user) {
                    
                    var uId = user.id || user.Id;
                    var uName = user.userName || user.UserName;
                    var uMail = user.email || user.Email;

                    select.append('<option value="' + uId + '">' + uName + ' (' + uMail + ')</option>');
                });
            });
        });
    </script>
}