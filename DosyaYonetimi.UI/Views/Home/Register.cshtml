@model DosyaYonetimi.UI.Models.RegisterViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <title>Kayıt Ol - Dosya Yönetim Portalı</title>
    <link href="~/sbadmin/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="~/sbadmin/css/sb-admin-2.min.css" rel="stylesheet">
</head>
<body class="bg-gradient-success">
    <div class="container">
        <div class="card o-hidden border-0 shadow-lg my-5">
            <div class="card-body p-0">
                <div class="row">
                    <div class="col-lg-5 d-none d-lg-block bg-register-image"></div>
                    <div class="col-lg-7">
                        <div class="p-5">
                            <div class="text-center">
                                <h1 class="h4 text-gray-900 mb-4">Yeni Hesap Oluştur!</h1>
                            </div>
                            <form class="user" asp-action="Register" asp-controller="Home" method="post">
                                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="text-align:center;"></div>

                                <div class="form-group">
                                    <input asp-for="UserName" type="text" class="form-control form-control-user" placeholder="Kullanıcı Adı" required>
                                </div>
                                <div class="form-group">
                                    <input asp-for="Email" type="email" class="form-control form-control-user" placeholder="E-Posta Adresi" required>
                                </div>
                                <div class="form-group row">
                                    <div class="col-sm-6 mb-3 mb-sm-0">
                                        <input asp-for="Password" type="password" class="form-control form-control-user" placeholder="Şifre" required>
                                    </div>
                                    <div class="col-sm-6">
                                        <input asp-for="PasswordConfirm" type="password" class="form-control form-control-user" placeholder="Şifre (Tekrar)" required>
                                    </div>
                                </div>
                                <button type="submit" class="btn btn-success btn-user btn-block">Hesabı Oluştur</button>
                            </form>
                            <hr>
                            <div class="text-center">
                                <a class="small" href="/Home/Login">Zaten bir hesabın var mı? Giriş Yap!</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>