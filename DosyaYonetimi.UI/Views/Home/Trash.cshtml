@model DosyaYonetimi.UI.Models.DriveViewModel
@{
    ViewData["Title"] = "Çöp Kutusu";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-trash text-danger mr-2"></i> Çöp Kutusu</h1>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Hata!</strong> @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Başarılı!</strong> @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
    </div>
}

<div class="card shadow mb-4 border-bottom-danger">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0" width="100%" cellspacing="0">
                <thead class="bg-light">
                    <tr>
                        <th width="5%" class="text-center">Tip</th>
                        <th width="45%">Ad</th>
                        <th width="20%">Boyut</th>
                        <th width="15%">Silinme Tarihi</th>
                        <th width="15%" class="text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Folders != null)
                    {
                        foreach (var folder in Model.Folders)
                        {
                            <tr>
                                <td class="text-center align-middle">
                                    <i class="fas fa-folder text-warning fa-lg opacity-50"></i>
                                </td>
                                <td class="align-middle font-weight-bold text-secondary">
                                    <del>@folder.Name</del>
                                </td>
                                <td class="align-middle text-muted">-</td>
                                <td class="align-middle text-muted">@folder.Created.ToShortDateString()</td>
                                <td class="text-center align-middle">
                                    <form asp-action="RestoreFolder" asp-controller="Home" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@folder.Id" />
                                        <button type="submit" class="btn btn-sm btn-light text-success" title="Geri Yükle">
                                            <i class="fas fa-trash-restore"></i>
                                        </button>
                                    </form>

                                    <form asp-action="HardDeleteFolder" asp-controller="Home" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@folder.Id" />
                                        <button type="submit" class="btn btn-sm btn-light text-danger" title="Kalıcı Olarak Sil" onclick="return confirm('Bu klasörü KALICI olarak silmek istediğinize emin misiniz? Geri alınamaz!');">
                                            <i class="fas fa-times-circle"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }

                    @if (Model.Files != null)
                    {
                        foreach (var file in Model.Files)
                        {
                            <tr>
                                <td class="text-center align-middle">
                                    <i class="fas fa-file-alt text-secondary fa-lg opacity-50"></i>
                                </td>
                                <td class="align-middle text-secondary font-weight-bold">
                                    <del>@file.Name</del> <span class="badge badge-secondary ml-2">@file.Extension</span>
                                </td>
                                <td class="align-middle text-muted">@file.SizeInMB.ToString("0.00") MB</td>
                                <td class="align-middle text-muted">@file.Created.ToShortDateString()</td>
                                <td class="text-center align-middle">

                                    <form asp-action="RestoreFile" asp-controller="Home" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@file.Id" />
                                        <button type="submit" class="btn btn-sm btn-light text-success" title="Geri Yükle">
                                            <i class="fas fa-trash-restore"></i>
                                        </button>
                                    </form>

                                    <form asp-action="HardDeleteFile" asp-controller="Home" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@file.Id" />
                                        <button type="submit" class="btn btn-sm btn-light text-danger" title="Kalıcı Olarak Sil" onclick="return confirm('Bu dosyayı KALICI olarak silmek istediğinize emin misiniz? Geri alınamaz!');">
                                            <i class="fas fa-times-circle"></i>
                                        </button>
                                    </form>

                                </td>
                            </tr>
                        }
                    }

                    @if ((Model.Folders == null || !Model.Folders.Any()) && (Model.Files == null || !Model.Files.Any()))
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                <i class="fas fa-dumpster fa-2x mb-2 d-block text-gray-300"></i>
                                Çöp kutusu tertemiz!
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>