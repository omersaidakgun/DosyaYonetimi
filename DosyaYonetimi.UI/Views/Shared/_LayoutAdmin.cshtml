<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>@ViewData["Title"] - Dosya Yönetimi</title>

    <link href="~/sbadmin/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet">
    <link href="~/sbadmin/css/sb-admin-2.min.css" rel="stylesheet">
</head>

<body id="page-top">
    <div id="wrapper">
        <ul class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion" id="accordionSidebar">
            <a class="sidebar-brand d-flex align-items-center justify-content-center" href="/Home/Index">
                <div class="sidebar-brand-icon rotate-n-15"><i class="fas fa-folder-open"></i></div>
                <div class="sidebar-brand-text mx-3">Dosya Portalı</div>
            </a>

            <hr class="sidebar-divider my-0">
            <li class="nav-item active"><a class="nav-link" href="/Home/Index"><i class="fas fa-fw fa-tachometer-alt"></i><span>Dashboard</span></a></li>

            <hr class="sidebar-divider">
            <div class="sidebar-heading">Yönetim</div>

            <li class="nav-item"><a class="nav-link" href="/Home/Files"><i class="fas fa-fw fa-file-alt"></i><span>Dosyalarım</span></a></li>

            <li class="nav-item"><a class="nav-link" href="/Home/SharedFiles"><i class="fas fa-fw fa-share-alt"></i><span>Paylaşılanlar</span></a></li>

            <li class="nav-item"><a class="nav-link" href="/Home/Trash"><i class="fas fa-fw fa-trash"></i><span>Çöp Kutusu</span></a></li>

            @if (User.Identity.Name != null && User.Identity.Name.ToLower() == "admin")
            {
                <hr class="sidebar-divider">
                <div class="sidebar-heading">Yönetim Paneli</div>

                <li class="nav-item">
                    <a class="nav-link" href="/Admin/Users">
                        <i class="fas fa-fw fa-users"></i>
                        <span>Kullanıcı Yönetimi</span>
                    </a>
                </li>
            }

            <hr class="sidebar-divider">
            <li class="nav-item"><a class="nav-link" href="/Home/Logout"><i class="fas fa-fw fa-sign-out-alt"></i><span>Çıkış Yap</span></a></li>
        </ul>

        <div id="content-wrapper" class="d-flex flex-column">
            <div id="content">
                <nav class="navbar navbar-expand navbar-light bg-white topbar mb-4 static-top shadow">
                    <ul class="navbar-nav ml-auto">
                        <li class="nav-item dropdown no-arrow">
                            <a class="nav-link dropdown-toggle" href="#">
                                <span class="mr-2 d-none d-lg-inline text-gray-600 font-weight-bold">@User.Identity.Name</span>
                                <img class="img-profile rounded-circle" src="~/sbadmin/img/undraw_profile.svg">
                            </a>
                        </li>
                    </ul>
                </nav>

                <div class="container-fluid">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>

    <script src="~/sbadmin/vendor/jquery/jquery.min.js"></script>
    <script src="~/sbadmin/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/sbadmin/vendor/jquery-easing/jquery.easing.min.js"></script>
    <script src="~/sbadmin/js/sb-admin-2.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>